# ─── Olisar arena ────────────────────────────────────────────────────────────
# Copy to .env.arena (gitignored) and fill in. Only the DELTAS from your ordinary
# .env belong here — GEMINI_API_KEY and everything else are inherited from it.
#
# Every value below is explained in arena/README.md, including how to create the
# Discord applications and which portal toggles each one needs.

# ─── The Olisar instance under test ──────────────────────────────────────────
# A SEPARATE Discord application from your real Olisar. Needs Message Content
# Intent and Server Members Intent enabled in the Developer Portal.
ARENA_DISCORD_TOKEN=

# The test server. Create a fresh Discord server, right-click it → Copy Server ID
# (Developer Mode must be on in Discord's Advanced settings).
ARENA_GUILD_ID=

# Your own Discord user id. The harness mints console sessions as this user and
# allowlists it, so it can drive the dashboard without an OAuth round-trip.
ARENA_OPERATOR_ID=

# ─── Server management ───────────────────────────────────────────────────────
# A third application, invited with Administrator, that creates channels and roles
# and reads the channel back for the transcript. Needs Server Members Intent.
ARENA_STEWARD_TOKEN=

# ─── The member-emulator fleet ───────────────────────────────────────────────
# One Discord application per persona in arena/personas/. The suffix must match the
# persona's `key`. These need NO privileged intents — the harness never opens a
# gateway connection for them. Invite each with just: Send Messages, Read Message
# History, View Channels.
ARENA_BOT_TOKEN_MIKA=
ARENA_BOT_TOKEN_DTRAIN=
ARENA_BOT_TOKEN_SALT=
ARENA_BOT_TOKEN_YUKI=
ARENA_BOT_TOKEN_ROOK=
ARENA_BOT_TOKEN_QUIET=

# `nowplaying` is different: a persona flagged third_party_bot, playing one of the
# server's OTHER bots rather than a member. It is deliberately kept out of
# OLISAR_PEER_BOT_IDS, so Olisar sees it as the bot it is. Needed by the
# other-bots-* scenarios — without it `see_other_bots` has nothing to govern,
# because every other bot in the arena is an honorary member.
ARENA_BOT_TOKEN_NOWPLAYING=

# ─── Isolation (defaults are fine) ───────────────────────────────────────────
# The arena keeps its own database, uploads, logs and ports so it cannot collide
# with a developer instance running from the same checkout.
ARENA_DATA_DIR=data/arena
ARENA_API_PORT=8770
ARENA_CONTROL_PORT=8771

# ─── Where the harness's own model calls go ──────────────────────────────────
# Two roles, each independently pointed at "claude" (the Claude CLI) or "gemini".
#
# Emulator dialogue defaults to Claude Haiku through the CLI, because it is high
# volume and would otherwise compete with the bot under test for the same ~10 RPM
# free tier — starving Olisar of exactly the quota whose absence gets recorded as a
# bad reply. Measured at ~$0.001 and ~3s per line.
ARENA_DIALOGUE_BACKEND=claude
ARENA_DIALOGUE_MODEL=haiku

# Judging is low volume and every verdict downstream rests on it, so it gets the
# stronger model. With both roles on Claude the free-tier Gemini quota belongs
# entirely to the instance under test. Verified: Sonnet scores 5/5 on the floor
# calibration and 6/6 on the subtle tier, with zero order flips.
# Re-run `arena calibrate` if you change this.
ARENA_JUDGE_BACKEND=claude
ARENA_JUDGE_MODEL=sonnet

# Path to the Claude CLI, if it isn't on PATH.
ARENA_CLAUDE_BIN=claude

# ─── Budgets ─────────────────────────────────────────────────────────────────
# Two ceilings, because the two backends are constrained differently. Gemini is
# rate-limited and shared with the instance under test, so its ceiling is a call
# count — it only applies if you point a role back at Gemini. Claude is billed, so
# its ceiling is dollars. Both are hard stops. Check both with `arena status`.
#
# Rough shape at the defaults: ~$0.001 per emulator line, ~$0.009 per judge call.
# Calibration is 22 judge calls (~$0.20) and runs once per loop round; a round over
# 8 scenarios lands around $0.60-0.80 all in.
ARENA_DAILY_CALL_BUDGET=800
ARENA_CLAUDE_DAILY_USD=5.0

# NOTE: `claude -p` uses whatever the CLI is logged in with. On a subscription,
# arena runs draw down the same usage limits as your interactive work — set
# ANTHROPIC_API_KEY in your environment to bill API credits instead.

# ─── Run governors ───────────────────────────────────────────────────────────
# Hard stops that keep a scenario from becoming an infinite bot-to-bot loop.
ARENA_MAX_MESSAGES=60
ARENA_MIN_GAP_SECONDS=2.5
ARENA_SCENARIO_TIMEOUT=420
