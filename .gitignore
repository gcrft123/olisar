# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Environment & secrets
.env
*.env
!.env.example
# The arena's env holds a bot token per emulator; only the template is tracked.
# (`*.env` doesn't match it — the name ends in `.arena`, not `.env`.)
.env.arena
!.env.arena.example

# Arena run artifacts: transcripts, scorecards, round records. All regenerable, and
# a live-lane run produces a directory each time. Variants stay tracked — they're
# small, they carry the hypothesis, and a promoted one is the thing to review.
arena/runs/

# Data (database, uploaded knowledge files, backups)
data/
logs/
*.db
*.db-wal
*.db-shm
*.bak
*.bak-*
*.orig

# Node / frontend
node_modules/
web/node_modules/
web/dist/
desktop/node_modules/

# Build artifacts (PyInstaller + Electron)
/build/
/dist/
desktop/out/
desktop/dist/

# Bundled native helper binaries (built from desktop/funnel-sidecar/)
desktop/resources/olisar-funnel
desktop/resources/olisar-funnel.exe
desktop/funnel-sidecar/olisar-funnel
desktop/funnel-sidecar/olisar-funnel.exe

# Editor / OS / tooling
.DS_Store
.idea/
.vscode/
.claude/

# Local dev helper (frontend hot-swap into the installed app bundle)
web/swap.sh

# Local-only Claude Code project guide (kept on disk, not tracked)
CLAUDE.md

# Design-lint hook caches
.impeccable/
